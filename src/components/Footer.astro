---
import { footerLinks as links } from "../data/nav";
---

<footer
  class="w-full py-section-gap px-margin-mobile md:px-margin-page flex flex-col gap-stack-md bg-deep text-on-deep"
>
  <div
    class="flex flex-col md:flex-row justify-between items-start md:items-end gap-12"
  >
    <div>
      <span class="font-headline-sm text-3xl font-bold tracking-tight">Sagar.</span>
      <p class="font-body-md text-body-md opacity-60 mt-4 max-w-sm">
        Engineering digital clarity through intentional code and minimalist
        aesthetics.
      </p>
    </div>
    <div class="flex flex-wrap gap-8">
      {
        links.map((link) => (
          <a
            class="font-ui-text text-ui font-semibold opacity-60 hover:opacity-100 transition-opacity"
            href={link.href}
          >
            {link.label}
          </a>
        ))
      }
    </div>
  </div>
</footer>
