---
import { navLinks, type NavLink } from "../data/nav";

interface Props {
  links?: NavLink[];
  brand?: string;
  brandHref?: string;
}

// Defaults reproduce the homepage nav so existing usages need no changes.
const {
  links = navLinks,
  brand = "Sagar",
  brandHref = "/#home",
} = Astro.props;

// One look for a link in either layout. `aria-current` (set by the scroll-spy
// below) is the single source of truth for "you are here".
const linkBase =
  "nav-link press font-ui-text font-medium text-ink-muted hover:text-ink aria-[current]:text-ink";
---

<!--
  --p (0 closed, 1 open) is set on this element by the script below and drives
  the menu, the scrim and the hamburger-to-close icon. The pill and the menu
  panel are siblings in a column so the panel can sit under the pill without
  any transform-based centering (which would skew offset measurements).
-->
<nav
  id="site-nav"
  aria-label="Primary"
  class="fixed top-0 inset-x-0 z-50 flex flex-col items-center px-4 pt-4 pointer-events-none"
>
  <!-- Dims the page behind the open menu and doubles as the tap-outside target. -->
  <div
    id="nav-scrim"
    class="nav-scrim fixed inset-0 -z-10 bg-black/20 dark:bg-black/50 pointer-events-none md:hidden"
    aria-hidden="true"
  >
  </div>

  <div
    class="material pointer-events-auto rounded-full flex items-center gap-6 md:gap-3 pl-5 pr-1 md:pr-1.5 py-1 md:py-1.5"
  >
    <a
      class="press font-headline-sm text-title font-bold text-ink rounded-full"
      href={brandHref}>{brand}</a
    >

    <!-- Desktop: inline links with a sliding "you are here" capsule. -->
    <div id="nav-links" class="relative hidden md:flex items-center gap-1">
      <span
        id="nav-indicator"
        aria-hidden="true"
        class="absolute top-0 bottom-0 left-0 rounded-full bg-ink/8 opacity-0 transition-opacity duration-200 pointer-events-none"
      ></span>
      {
        links.map((link) => (
          <a
            class:list={[linkBase, "relative text-ui px-4 py-1.5 rounded-full"]}
            href={link.href}
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <!-- Mobile: 44x44 toggle; the negative margin keeps the pill compact. -->
    <button
      id="nav-toggle"
      class="press md:hidden text-ink size-11 -my-1 grid place-items-center rounded-full focus-visible:outline-offset-[-2px]"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="nav-menu"
    >
      <svg
        class="size-5"
        viewBox="0 0 20 20"
        fill="currentColor"
        aria-hidden="true"
      >
        <rect
          class="nav-bar nav-bar-top"
          x="3"
          y="6.25"
          width="14"
          height="1.5"
          rx="0.75"></rect>
        <rect
          class="nav-bar nav-bar-bottom"
          x="3"
          y="12.25"
          width="14"
          height="1.5"
          rx="0.75"></rect>
      </svg>
    </button>
  </div>

  <!-- Mobile menu. Closed = invisible + inert (not focusable, not announced). -->
  <div
    id="nav-menu"
    inert
    class="nav-menu material invisible pointer-events-auto md:hidden mt-2 w-full max-w-80 rounded-3xl p-2 flex flex-col"
  >
    {
      links.map((link) => (
        <a
          class:list={[
            linkBase,
            "block text-title px-4 py-3 rounded-2xl aria-[current]:bg-ink/8 aria-[current]:font-semibold",
          ]}
          href={link.href}
        >
          {link.label}
        </a>
      ))
    }
  </div>
</nav>

<script>
  import { createSpring } from "../lib/spring";

  const nav = document.getElementById("site-nav")!;
  const menu = document.getElementById("nav-menu")!;
  const toggle = document.getElementById("nav-toggle")!;
  const scrim = document.getElementById("nav-scrim")!;
  const linksEl = document.getElementById("nav-links")!;
  const indicator = document.getElementById("nav-indicator")!;

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const desktop = window.matchMedia("(min-width: 768px)");

  // ------------------------------------------------------------------------
  // Mobile menu: one spring on progress p in [0, 1].
  //
  // Interruptible by construction: a tap only changes the spring's *target*.
  // The value and velocity carry through, so grabbing a half-open menu and
  // closing it reverses smoothly from where it is, never from where it was
  // going. Critically damped (no overshoot): a menu that merely appears
  // shouldn't bounce - bounce is for gestures that carried momentum.
  // ------------------------------------------------------------------------
  let open = false;

  function render(p: number) {
    nav.style.setProperty("--p", p.toFixed(4));
    // Fully closed -> take it out of the tab order and the a11y tree.
    const closed = spring.target === 0 && p < 0.002;
    menu.classList.toggle("invisible", closed);
    menu.inert = closed;
    scrim.classList.toggle("pointer-events-none", !open);
    scrim.classList.toggle("pointer-events-auto", open);
  }

  const spring = createSpring(0, render, { response: 0.35, damping: 1 });

  function syncMotionPreference() {
    // Reduced motion: still responsive, but a short cross-fade (see CSS).
    spring.options.response = reduceMotion.matches ? 0.15 : 0.35;
  }
  syncMotionPreference();
  reduceMotion.addEventListener("change", syncMotionPreference);

  // Grow from the toggle button, not from the panel's centre: the panel
  // visibly belongs to the control that opened it, and closes back into it.
  function anchorOrigin() {
    const t = toggle.getBoundingClientRect();
    const n = nav.getBoundingClientRect();
    // offsetLeft is layout position, so it's unaffected by the in-flight scale.
    const x = t.left + t.width / 2 - n.left - menu.offsetLeft;
    menu.style.setProperty("--origin-x", `${x}px`);
  }

  function setOpen(next: boolean, { restoreFocus = false } = {}) {
    open = next;
    toggle.setAttribute("aria-expanded", String(next));
    toggle.setAttribute("aria-label", next ? "Close menu" : "Open menu");
    if (next) anchorOrigin();
    spring.to(next ? 1 : 0);
    if (!next && restoreFocus) toggle.focus();
  }

  toggle.addEventListener("click", () => setOpen(!open));
  scrim.addEventListener("click", () => setOpen(false));
  menu.addEventListener("click", (e) => {
    if ((e.target as Element).closest("a")) setOpen(false);
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && open) {
      setOpen(false, { restoreFocus: menu.contains(document.activeElement) });
    }
  });
  window.addEventListener("resize", () => open && anchorOrigin());

  // Crossing into the desktop layout: snap closed, no animation.
  desktop.addEventListener("change", (e) => {
    if (e.matches && (open || spring.value > 0)) {
      open = false;
      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-label", "Open menu");
      spring.set(0);
    }
    moveIndicator(false);
  });

  // ------------------------------------------------------------------------
  // Desktop indicator: a capsule that springs between links (position and
  // width are separate springs, like an iOS segmented control).
  // ------------------------------------------------------------------------
  let indicatorPlaced = false;

  const indX = createSpring(
    0,
    (x) => (indicator.style.transform = `translateX(${x}px)`),
    { response: 0.4, damping: 1, restDelta: 0.05 },
  );
  const indW = createSpring(
    0,
    (w) => (indicator.style.width = `${w}px`),
    { response: 0.4, damping: 1, restDelta: 0.05 },
  );

  function moveIndicator(animate = true) {
    if (!desktop.matches) return;
    const active = linksEl.querySelector<HTMLAnchorElement>(
      "a[aria-current]",
    );
    if (!active) {
      indicator.classList.add("opacity-0");
      indicatorPlaced = false; // re-enter without sweeping in from old spot
      return;
    }
    const x = active.offsetLeft;
    const w = active.offsetWidth;
    if (!indicatorPlaced || !animate || reduceMotion.matches) {
      indX.set(x);
      indW.set(w);
      indicatorPlaced = true;
    } else {
      indX.to(x);
      indW.to(w);
    }
    indicator.classList.remove("opacity-0");
  }

  // Keep the capsule aligned if fonts load late or the window resizes.
  new ResizeObserver(() => moveIndicator(false)).observe(linksEl);

  // ------------------------------------------------------------------------
  // Scroll-spy: mark the link whose section is in view. Lives in the Nav so
  // every page that renders it (home, /blog) gets the behaviour. Links match
  // sections via href.includes(id), so on-page anchors (#projects) and
  // homepage-rooted ones (/#works) both resolve.
  // ------------------------------------------------------------------------
  const sections = document.querySelectorAll("section[id]");
  const spyLinks = nav.querySelectorAll<HTMLAnchorElement>("a.nav-link");

  function updateActiveLink() {
    let current = "";
    sections.forEach((section) => {
      const sectionTop = (section as HTMLElement).offsetTop;
      if (window.scrollY >= sectionTop - 100) {
        current = section.getAttribute("id") ?? "";
      }
    });

    // Near the bottom the last section's top may be unreachable, so the
    // loop above can't select it. Force the last section as active.
    const atBottom =
      window.innerHeight + window.scrollY >=
      document.documentElement.scrollHeight - 2;
    if (atBottom && sections.length) {
      current = sections[sections.length - 1].getAttribute("id") ?? current;
    }

    spyLinks.forEach((link) => {
      const href = link.getAttribute("href") ?? "";
      if (current && href.includes(current)) {
        link.setAttribute("aria-current", "location");
      } else {
        link.removeAttribute("aria-current");
      }
    });
    moveIndicator();
  }

  // Coalesce scroll bursts into one update per frame - updateActiveLink reads
  // layout (offsetTop), so running it on every raw scroll event would force
  // repeated reflows.
  let ticking = false;
  window.addEventListener("scroll", () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      updateActiveLink();
      ticking = false;
    });
  });
  updateActiveLink();
</script>
