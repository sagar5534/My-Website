---
import Icon, { type IconName } from "./Icon.astro";

// `detail` is the quiet secondary value on the right (like iOS Settings).
const links: { label: string; detail: string; href: string; icon: IconName }[] = [
  { label: "LinkedIn", detail: "in/p-sagar", href: "https://linkedin.com/in/p-sagar", icon: "linkedin" },
  { label: "GitHub", detail: "sagar5534", href: "https://github.com/sagar5534", icon: "github" },
  { label: "Email", detail: "sagar.rpatel@icloud.com", href: "mailto:sagar.rpatel@icloud.com", icon: "mail" },
  { label: "Resume", detail: "PDF", href: "/SagarPatel-Resume.pdf", icon: "file" },
];
---

<section
  id="contact"
  class="px-margin-mobile md:px-margin-page py-section-gap"
>
  <div class="max-w-7xl mx-auto">
    <div class="reveal grid grid-cols-1 lg:grid-cols-12 gap-8">
      <div class="lg:col-span-4">
        <h2 class="font-headline-lg text-headline-lg">Let's Connect</h2>
        <p
          class="font-ui-text text-body-md text-ink-muted mt-4 max-w-sm"
        >
          Currently open to new engineering challenges, collaborative
          open-source projects
        </p>
      </div>
      <div class="lg:col-span-8">
        <!-- Inset grouped list: one surface, hairlines inset to the label. -->
        <div class="rounded-3xl bg-surface overflow-hidden shadow-[var(--shadow-card)]">
          {
            links.map((link) => (
              <a
                class="relative flex items-center gap-4 px-5 min-h-16 transition-colors hover:bg-fill active:bg-fill-strong active:duration-75 group not-first:before:absolute not-first:before:top-0 not-first:before:left-[3.75rem] not-first:before:right-0 not-first:before:h-px not-first:before:bg-line"
                href={link.href}
              >
                <Icon name={link.icon} class="size-6" />
                <span class="font-headline-sm text-title font-semibold">
                  {link.label}
                </span>
                <span class="ml-auto min-w-0 truncate hidden sm:block font-ui-text text-ui text-ink-muted">
                  {link.detail}
                </span>
                <Icon
                  name="arrow-up-right"
                  class="size-5 text-ink-faint max-sm:ml-auto transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                />
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
