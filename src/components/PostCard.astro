---
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const { title, subtitle, date, image, repo } = post.data;

// A repo entry links out to GitHub; otherwise to the internal write-up page.
const href = repo ?? `/blog/${post.id}`;
const external = Boolean(repo);

const dateLabel = date?.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<a
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  class="card group relative isolate block aspect-video rounded-3xl overflow-hidden bg-fill"
>
  {
    image ? (
      <img
        class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04]"
        src={image}
        alt={title}
        width="1280"
        height="720"
        loading="lazy"
        decoding="async"
      />
    ) : (
      // No cover image: a quiet tonal gradient, with the title set in ink.
      <div class="w-full h-full bg-gradient-to-br from-fill to-fill-strong" />
    )
  }
  <div
    class:list={[
      "absolute inset-0 flex flex-col justify-end p-6 md:p-7",
      image
        ? "bg-gradient-to-t from-black/80 via-black/20 to-transparent text-white"
        : "text-ink",
    ]}
  >
    {
      dateLabel && (
        <span class="font-ui-text text-caption font-medium opacity-70 mb-1">
          {dateLabel}
        </span>
      )
    }
    <h3 class="font-headline-sm text-headline-sm">{title}</h3>
    {subtitle && <p class="font-body-md text-body-md opacity-80">{subtitle}</p>}
  </div>
</a>
