---
const badges = ["Available for hire", "Based in Toronto"];

// First role is server-rendered so the page is correct with JS disabled; the
// client script (index.astro) rotates through the rest.
const roles = ["Software Engineer", "Full Stack Developer", "Interface Designer"];
---

<section
  id="home"
  class="min-h-svh flex flex-col justify-center items-center px-margin-mobile md:px-margin-page pt-32 pb-section-gap relative overflow-hidden"
>
  <div class="hero-glow absolute inset-0 pointer-events-none" aria-hidden="true"></div>

  <div class="text-center z-10 w-full">
    <div class="mb-stack-sm flex justify-center gap-2">
      {
        badges.map((badge) => (
          <span class="font-ui-text text-caption font-semibold px-3 py-1 border border-ink-faint/50 rounded-full">
            {badge}
          </span>
        ))
      }
    </div>

    <!-- The h1 is stable text for screen readers and search engines. The
         visible, rotating role is decorative and hidden from assistive tech so
         it isn't re-announced every few seconds. min-h reserves two lines
         (the longest role wraps to two) so rotating never shifts the layout. -->
    <h1
      class="font-hero-display text-hero-display uppercase mb-stack-md mx-auto max-w-6xl min-h-[1.85em] flex items-center justify-center text-balance"
    >
      <span class="sr-only">
        Sagar Patel: software engineer, full stack developer and interface
        designer
      </span>
      <span id="hero-role" aria-hidden="true" data-roles={JSON.stringify(roles)}>
        {roles[0]}
      </span>
    </h1>

    <p
      class="font-sub-description text-sub-description max-w-2xl mx-auto opacity-70"
    >
      Crafting precise digital experiences through code and minimalist design
      principles.
    </p>

    <div class="mt-stack-md">
      <a
        class="press inline-block bg-inverse text-on-inverse px-8 py-4 rounded-full font-ui-text text-ui font-semibold hover:opacity-85"
        href="/SagarPatel-Resume.pdf" target="_blank" rel="noopener">View Resume</a
      >
    </div>
  </div>
</section>
