---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Intro from "../components/Intro.astro";
import Experience from "../components/Experience.astro";
import Works from "../components/Works.astro";
import Connect from "../components/Connect.astro";
---

<BaseLayout
  title="Sagar | Software Engineer"
  type="website"
  person={true}
  mainClass=""
>
  <Hero />
  <Intro />
  <Experience />
  <Works />
  <Connect />
</BaseLayout>

<script>
  // ----------------------------------------------------------------------
  // Rotating role. The h1 text is static (see Hero.astro); only the visible,
  // aria-hidden span changes. Each swap is a short blur + fade + rise rather
  // than character-by-character typing: nothing reflows mid-word and there is
  // no endlessly blinking cursor.
  // ----------------------------------------------------------------------
  const el = document.getElementById("hero-role");
  const roles: string[] = JSON.parse(el?.dataset.roles ?? "[]");

  const HOLD_MS = 2800;
  const OUT = { duration: 260, easing: "cubic-bezier(0.4, 0, 1, 1)", fill: "forwards" } as const;
  const IN = { duration: 520, easing: "cubic-bezier(0.22, 1, 0.36, 1)", fill: "backwards" } as const;

  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  let index = 0;

  async function rotate() {
    if (!el) return;
    // Don't burn cycles (or swap text) while the tab is in the background.
    if (document.hidden) return schedule();

    await el.animate(
      [
        { opacity: 1, filter: "blur(0px)", transform: "translateY(0)" },
        { opacity: 0, filter: "blur(10px)", transform: "translateY(-0.08em)" },
      ],
      OUT,
    ).finished;

    index = (index + 1) % roles.length;
    el.textContent = roles[index];

    // Cancel the "forwards" hold from the exit animation, then play the entrance.
    el.getAnimations().forEach((a) => a.cancel());
    el.animate(
      [
        { opacity: 0, filter: "blur(10px)", transform: "translateY(0.08em)" },
        { opacity: 1, filter: "blur(0px)", transform: "translateY(0)" },
      ],
      IN,
    );
    schedule();
  }

  function schedule() {
    setTimeout(rotate, HOLD_MS);
  }

  // Reduced motion: keep the first role, static. No rotation at all.
  if (el && roles.length > 1 && !reduceMotion) schedule();
</script>
